# ====================
# MinerU API
# ====================
SHOPKEEPER_BRAIN_MINERU_BASE_URL=https://mineru.net/api/v4
SHOPKEEPER_BRAIN_MINERU_API_TOKEN=

# ====================
# Vision model: OpenAI
# ====================
SHOPKEEPER_BRAIN_VL_BASE_URL=http://127.0.0.1:3425/v1
SHOPKEEPER_BRAIN_VL_API_KEY=
SHOPKEEPER_BRAIN_VL_MODEL=codex/gpt-6-luna
SHOPKEEPER_BRAIN_VL_TEMPERATURE=0.1

# ====================
# LLM model: OpenAI
# ====================
SHOPKEEPER_BRAIN_LLM_BASE_URL=http://127.0.0.1:3425/v1
SHOPKEEPER_BRAIN_LLM_API_KEY=
SHOPKEEPER_BRAIN_LLM_MODEL=codex/gpt-6-luna
SHOPKEEPER_BRAIN_LLM_TEMPERATURE=0.1

# ====================
# Sliding-window rate limit for VL requests
# ====================
SHOPKEEPER_BRAIN_IMAGE_MAX_REQUESTS=10
SHOPKEEPER_BRAIN_IMAGE_WINDOW_SECONDS=60

# ====================
# MinIO
# ====================
# 不要加 http://，也不要在末尾加路径
SHOPKEEPER_BRAIN_MINIO_ENDPOINT=localhost:9000
SHOPKEEPER_BRAIN_MINIO_ACCESS_KEY=your-access-key
SHOPKEEPER_BRAIN_MINIO_SECRET_KEY=your-secret-key
SHOPKEEPER_BRAIN_MINIO_BUCKET=knowledge-base
SHOPKEEPER_BRAIN_MINIO_IMAGE_PREFIX=upload-images
SHOPKEEPER_BRAIN_MINIO_SECURE=false

# ====================
# BGE-M3：相对路径以项目根目录为起点
# ====================
SHOPKEEPER_BRAIN_BGE_M3_PATH=workspace/models/bge-m3
SHOPKEEPER_BRAIN_BGE_DEVICE=cpu
SHOPKEEPER_BRAIN_BGE_FP16=false

# ====================
# Milvus
# ====================
SHOPKEEPER_BRAIN_MILVUS_URI=http://192.168.150.120:19530
SHOPKEEPER_BRAIN_MILVUS_ITEM_NAME_COLLECTION=kb_item_names
SHOPKEEPER_BRAIN_MILVUS_CHUNK_COLLECTION=kb_chunks

# ====================
# MongoDB
# ====================
# 账号密码只填在本地 .env；密码含 @ : / % 等字符时要先做 URL 编码
SHOPKEEPER_BRAIN_MONGO_URI=mongodb://admin:your-password@192.168.150.120:27017/?authSource=admin
SHOPKEEPER_BRAIN_MONGO_DB_NAME=kb001