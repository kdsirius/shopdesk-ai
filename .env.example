# ====================
# MinerU API
# ====================
MINERU_BASE_URL=https://mineru.net/api/v4
MINERU_API_TOKEN=

# ====================
# Vision model: OpenAI
# ====================
VL_BASE_URL=http://127.0.0.1:3425/v1
VL_API_KEY=
VL_MODEL=codex/gpt-6-luna
VL_TEMPERATURE=0.1

# ====================
# LLM model: OpenAI
# ====================
LLM_BASE_URL=http://127.0.0.1:3425/v1
LLM_API_KEY=
LLM_MODEL=codex/gpt-6-luna
LLM_TEMPERATURE=0.1

# ====================
# Sliding-window rate limit for VL requests
# ====================
IMAGE_MAX_REQUESTS=10
IMAGE_WINDOW_SECONDS=60

# ====================
# MinIO
# ====================
# 不要加 http://，也不要在末尾加路径
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=your-access-key
MINIO_SECRET_KEY=your-secret-key
MINIO_BUCKET=knowledge-base
MINIO_IMAGE_PREFIX=upload-images
MINIO_SECURE=false

# ====================
# BGE-M3：相对路径以项目根目录为起点
# ====================
BGE_M3_PATH=workspace/models/bge-m3
BGE_DEVICE=cpu
BGE_FP16=false

# ====================
# Milvus
# ====================
MILVUS_URI=http://192.168.150.120:19530
MILVUS_ITEM_NAME_COLLECTION=kb_item_names
MILVUS_CHUNK_COLLECTION=kb_chunks

# ====================
# MongoDB
# ====================
# 账号密码只填在本地 .env；密码含 @ : / % 等字符时要先做 URL 编码
MONGO_URI=mongodb://admin:your-password@192.168.150.120:27017/?authSource=admin
MONGO_DB_NAME=kb001

# ====================
# Tavily 联网搜索（远程 MCP）
# ====================
# 地址留空时使用官方地址；密钥只填在本地 .env，不要提交
TAVILY_MCP_URL=https://mcp.tavily.com/mcp/
TAVILY_API_KEY=

# ====================
# 重排模型：阿里云百炼（DashScope）
# ====================
# 模型名留空时使用 qwen3-rerank；instruct 留空表示不传；密钥只填在本地 .env，不要提交
RERANK_MODEL=qwen3-rerank
RERANK_INSTRUCT=
RERANK_API_KEY=